# Valeurs disponibles dans Supabase > Project Settings > API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Variables utilisées uniquement par le serveur du chatbot.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY
GROQ_API_KEY=YOUR_GROQ_API_KEY

# Ne jamais placer SUPABASE_SERVICE_ROLE_KEY dans une application Vite.
# Ne jamais préfixer GROQ_API_KEY avec VITE_ : elle doit rester côté serveur.
